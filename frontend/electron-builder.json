{
  "appId": "com.viyabaram.cloud",
  "productName": "வியாபாரம் (VIYABARAM CLOUD)",
  "copyright": "Copyright © 2026 MCube Computers. All Rights Reserved.",
  "directories": {
    "output": "release"
  },
  "files": [
    "dist/**/*",
    "electron/**/*",
    "package.json"
  ],
  "win": {
    "target": [
      {
        "target": "nsis",
        "arch": ["x64"]
      },
      {
        "target": "portable",
        "arch": ["x64"]
      }
    ],
    "icon": "public/favicon.ico"
  },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "shortcutName": "வியாபாரம் (VIYABARAM CLOUD)"
  }
}
