{
  "appId": "com.vanigam.pos",
  "productName": "வணிகம் (Vanigam)",
  "copyright": "Copyright © 2026 வணிகம் (Vanigam)",
  "directories": {
    "output": "release"
  },
  "files": [
    "dist/**/*",
    "electron/**/*",
    "package.json"
  ],
  "win": {
    "target": [
      {
        "target": "nsis",
        "arch": ["x64"]
      },
      {
        "target": "portable",
        "arch": ["x64"]
      }
    ],
    "icon": "public/favicon.ico"
